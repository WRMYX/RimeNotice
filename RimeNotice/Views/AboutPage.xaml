<Page x:Class="RimeNotice.Views.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Padding="0,0,0,36" Spacing="16">
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
    <StackPanel Padding="24" Spacing="16">
     <Grid x:Name="ProductGrid" ColumnSpacing="16" RowSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Image Source="ms-appx:///Assets/RimeNotice-Logo.svg" Width="64" Height="64" Stretch="Uniform" AutomationProperties.Name="RimeNotice 软件 Logo"/>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
       <TextBlock Text="RimeNotice" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
       <TextBlock Text="雾凇消息提醒" TextWrapping="Wrap"/>
       <TextBlock x:Name="VersionText" Text="版本 1.0.0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
      <StackPanel x:Name="DeveloperPanel" Grid.Column="2" VerticalAlignment="Center" Spacing="8">
       <TextBlock Text="开发者" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Image x:Name="DeveloperLogo" Width="160" Height="32" Stretch="Uniform" HorizontalAlignment="Left" Tapped="DeveloperLogo_Tapped" AutomationProperties.Name="MYXMJY 开发者 Logo"/>
      </StackPanel>
     </Grid>
     <TextBlock Text="让重要消息及时被看见。" TextWrapping="Wrap"/>
     <TextBlock Text="面向 Windows 的即时 QQ 通知提醒工具。获得权限后随软件打开自动监听；需要回看消息时，直接打开 QQ。" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </Border>
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
    <StackPanel Spacing="12">
     <TextBlock Text="软件技术栈" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
     <TextBlock Text="C# · .NET 10 LTS（10.0.13）" TextWrapping="Wrap"/>
     <TextBlock Text="WinUI 3 · Windows App SDK 2.5.1" TextWrapping="Wrap"/>
     <TextBlock Text="Windows 原生 API · UserNotificationListener · Shell_NotifyIcon" TextWrapping="Wrap"/>
     <TextBlock Text="System.Text.Json · MSIX" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</Page>
