<Page x:Class="RimeNotice.Views.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Padding="0,0,0,36" Spacing="16">
   <Expander Style="{StaticResource SettingExpanderStyle}" IsExpanded="False" HorizontalContentAlignment="Stretch">
    <Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><Image Source="ms-appx:///Assets/RimeNotice-Logo.svg" Width="40" Height="40"/><StackPanel VerticalAlignment="Center"><TextBlock Text="RimeNotice" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="雾凇消息提醒" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel></Expander.Header>
    <Border Style="{StaticResource SettingCardStyle}" Padding="24"><StackPanel Spacing="16">
     <Grid x:Name="ProductGrid" ColumnSpacing="16" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="ms-appx:///Assets/RimeNotice-Logo.svg" Width="64" Height="64" Stretch="Uniform" AutomationProperties.Name="RimeNotice 软件 Logo"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="RimeNotice" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"/><TextBlock Text="雾凇消息提醒" TextWrapping="Wrap"/><TextBlock x:Name="VersionText" Text="版本 1.0.0" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
     <TextBlock Text="让重要消息及时被看见。" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="面向 Windows 的即时 QQ 通知提醒工具。获得权限后随软件打开自动监听；需要回看消息时，直接打开 QQ。" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel Spacing="8"><TextBlock Text="软件技术栈" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="C# · .NET 10 LTS（10.0.13）"/><TextBlock Text="WinUI 3 · Windows App SDK 2.5.1"/><TextBlock Text="Windows 原生 API · UserNotificationListener · Shell_NotifyIcon" TextWrapping="Wrap"/><TextBlock Text="System.Text.Json · MSIX"/></StackPanel>
    </StackPanel></Border>
   </Expander>
   <Expander Style="{StaticResource SettingExpanderStyle}" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><Image x:Name="DeveloperHeaderLogo" Width="150" Height="30" Stretch="Uniform"/><TextBlock Text="开发者与 MYXMJY" VerticalAlignment="Center"/></StackPanel></Expander.Header><Border Style="{StaticResource SettingCardStyle}" Padding="20"><StackPanel Spacing="12"><Image x:Name="DeveloperLogo" Width="180" Height="36" Stretch="Uniform" HorizontalAlignment="Left" Tapped="DeveloperLogo_Tapped" AutomationProperties.Name="MYXMJY 开发者 Logo"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE774;"/><TextBlock Text="官网 · 未完工"/></StackPanel></Button><Button IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE736;"/><TextBlock Text="文档 · 未完工"/></StackPanel></Button></StackPanel></StackPanel></Border></Expander>
   <Border Style="{StaticResource SettingCardStyle}" Padding="16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="项目与官网" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Tag="https://github.com/WRMYX/RimeNotice" Click="ProjectLink_Click"><StackPanel Orientation="Horizontal" Spacing="8"><Image x:Name="ProjectGithubLogo" Source="ms-appx:///Assets/GitHub-Mark-White.svg" Width="18" Height="18"/><TextBlock Text="GitHub"/></StackPanel></Button><Button Tag="https://RimeNotice.MYXMJY.Top" Style="{ThemeResource AccentButtonStyle}" Click="ProjectLink_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE774;"/><TextBlock Text="官网"/></StackPanel></Button></StackPanel><InfoBar Grid.ColumnSpan="2" x:Name="LinkError" IsOpen="False" IsClosable="True" Severity="Error"/></Grid></Border>
   <Border Style="{StaticResource SettingCardStyle}" Padding="16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="问题反馈" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="如果遇到问题、需要反馈或想提交建议，请前往 GitHub Issues。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Click="Feedback_Click" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="8"><Image x:Name="FeedbackGithubLogo" Source="ms-appx:///Assets/GitHub-Mark-White.svg" Width="18" Height="18"/><TextBlock Text="打开 GitHub 问题反馈"/></StackPanel></Button></Grid></Border>
   <Border Style="{StaticResource SettingCardStyle}" Padding="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE8FA;"/><StackPanel Spacing="4"><TextBlock Text="支持 RimeNotice" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="感谢你支持项目的持续维护。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel><Button Grid.Column="1" Click="Support_Click" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE735;"/><TextBlock Text="支持项目"/></StackPanel></Button></Grid></Border>
  </StackPanel>
 </ScrollViewer>
</Page>
