<Page x:Class="RimeNotice.Views.DebugPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled"><StackPanel Padding="0,0,0,36" Spacing="12">
  <InfoBar IsOpen="True" IsClosable="False" Title="开发者调试" Message="模拟通知用于检查显示效果。真实接收需通过 QQ 消息验证。"/>
  <TextBlock Text="原生父窗口对照（实验）" Style="{ThemeResource SubtitleTextBlockStyle}"/>
  <ComboBox x:Name="NativeHostChoice" Header="仅影响原生弹窗，从下一条通知生效" HorizontalAlignment="Stretch" SelectionChanged="NativeHost_Changed">
   <ComboBoxItem Content="紧凑父窗口＋独立遮罩（现有）"/>
   <ComboBoxItem Content="全屏父窗口＋同窗口遮罩（实验）"/>
  </ComboBox>
  <ToggleSwitch x:Name="HostMaskToggle" Header="背景遮罩" Toggled="HostMask_Toggled"/>
  <TextBlock Text="全屏覆盖通知所在显示器（含任务栏），遮罩拦截点击但点击不关闭；其他显示器不覆盖。关闭背景遮罩时暂用紧凑父窗口，避免透明全屏窗口挡住桌面。连续消息保持遮罩，最后一条退出后释放窗口。" TextWrapping="Wrap"/>
  <TextBlock Text="独立通知模拟" Style="{ThemeResource SubtitleTextBlockStyle}"/>
  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Button HorizontalAlignment="Stretch" Content="普通通知" Tag="Normal" Click="Preview_Click" MinHeight="36"/>
  <Button Grid.Column="1" HorizontalAlignment="Stretch" Content="重要通知" Tag="Important" Click="Preview_Click" MinHeight="36"/>
  <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="呼叫提醒" Tag="Calling" Click="Preview_Click" MinHeight="36"/>
  </Grid>
  <TextBox x:Name="Diagnostics" Header="接收状态" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  <StackPanel Orientation="Horizontal" Spacing="8">
  <Button Content="刷新状态" Click="Refresh_Click" MinHeight="36"/>
  <Button Content="导出诊断" Click="Export_Click" MinHeight="36"/>
  </StackPanel>
  <TextBlock Text="图片与原生动画采样：仅手动开启后记录测试消息原文、文件名和窗口边界；不上传，最多 5 分钟／16 MiB。停止后再发送日志。" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="开始诊断采样" Click="StartCapture_Click"/><Button Content="停止并保存采样" Click="StopCapture_Click"/></StackPanel>
  <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap"/>
  <TextBlock x:Name="ExportStatus" TextWrapping="Wrap"/>
  <TextBlock Text="规则、音频、系统语音和兼容接收已接入。图标、材质、音频和来源错误可在诊断中查看。" TextWrapping="Wrap"/>
  <Button Content="预览长正文与短名字" Click="LongPreview_Click" MinHeight="36"/>
  <Button Content="清理 RN 临时图标缓存" Click="ClearCache_Click" MinHeight="36"/>
  <Button Content="退出开发者调试" Click="ExitDeveloper_Click" MinHeight="36"/>
 </StackPanel></ScrollViewer>
</Page>
