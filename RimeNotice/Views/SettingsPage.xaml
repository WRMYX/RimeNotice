<Page x:Class="RimeNotice.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel Padding="0,0,0,36" Spacing="8">
<TextBlock Text="启动" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" Margin="0,0,0,4"/>
<Border Style="{StaticResource SettingCardStyle}"><Grid Tag="SettingRow" Padding="16,12" MinHeight="60" ColumnSpacing="12" RowSpacing="0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="开机自启动" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/><TextBlock Text="登录 Windows 后在托盘中接收消息。" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
 <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent="" Toggled="Startup_Toggled" AutomationProperties.Name="开机自启动"/>
 </Grid></Border>
<TextBlock x:Name="StartupDescription" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/><HyperlinkButton Content="打开 Windows 启动应用设置" NavigateUri="ms-settings:startupapps" HorizontalAlignment="Left"/><TextBlock Text="外观" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" Margin="0,16,0,4"/>
<Border Style="{StaticResource SettingCardStyle}"><Grid Tag="SettingRow" Padding="16,12" MinHeight="60" ColumnSpacing="12" RowSpacing="0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="应用主题" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/></StackPanel>
 <ComboBox x:Name="ThemeChoice" Grid.Column="1" Width="180" SelectionChanged="ThemeChoice_SelectionChanged" AutomationProperties.Name="应用主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
 </Grid></Border>
<TextBlock Text="通知显示" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" Margin="0,16,0,4"/>
<Border Style="{StaticResource SettingCardStyle}"><Grid Tag="SettingRow" Padding="16,12" MinHeight="60" ColumnSpacing="12" RowSpacing="0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="普通消息（秒）" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/></StackPanel>
 <NumberBox x:Name="NormalDuration" Grid.Column="1" Width="140" Minimum="1" Maximum="120" SpinButtonPlacementMode="Compact" ValueChanged="DurationChanged"/>
 </Grid></Border>
<Border Style="{StaticResource SettingCardStyle}"><Grid Tag="SettingRow" Padding="16,12" MinHeight="60" ColumnSpacing="12" RowSpacing="0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="重要消息（秒）" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/></StackPanel>
 <NumberBox x:Name="ImportantDuration" Grid.Column="1" Width="140" Minimum="1" Maximum="120" SpinButtonPlacementMode="Compact" ValueChanged="DurationChanged"/>
 </Grid></Border>
<Border Style="{StaticResource SettingCardStyle}"><Grid Tag="SettingRow" Padding="16,12" MinHeight="60" ColumnSpacing="12" RowSpacing="0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="呼叫提醒（秒）" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/></StackPanel>
 <NumberBox x:Name="CallingDuration" Grid.Column="1" Width="140" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" ValueChanged="DurationChanged"/>
 </Grid></Border>
<TextBlock Text="声音与语音" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" Margin="0,16,0,4"/>
<TextBlock Text="在侧边栏“声音与语音”中设置提示音、呼叫铃声和本机语音。" TextWrapping="Wrap"/><InfoBar x:Name="SaveError" IsOpen="False" IsClosable="False" Severity="Error" Title="设置保存失败"/> </StackPanel></ScrollViewer>
</Page>
